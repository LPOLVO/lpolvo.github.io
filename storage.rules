rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ── avatars: users can read/write their own avatar ──
    match /avatars/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // ── banners: users can read/write their own banner ──
    match /banners/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // ── thumbnails: users can upload thumbnails for their own scripts ──
    match /thumbnails/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
